{
  "spec_version": "1.0",
  "name": "NQ prior high sweep then bearish FVG",
  "instrument": "NQ",
  "signal_timeframe": "15m",
  "fill_resolution": "1s",
  "ai_model_version": "claude-opus-4-8",
  "asset_class": "futures",
  "execution_latency_class": "real-time",
  "sessions": [
    {
      "name": "cash_rth",
      "tz": "America/New_York",
      "start": "09:30",
      "end": "16:00",
      "days": [1, 2, 3, 4, 5]
    },
    {
      "name": "ny_am",
      "tz": "America/New_York",
      "start": "09:00",
      "end": "11:00",
      "days": [1, 2, 3, 4, 5]
    }
  ],
  "blocks": [
    {
      "id": "cash_rth_levels",
      "type": "session_levels",
      "params": {
        "session": "cash_rth",
        "levels": ["high", "low"],
        "which": "prior_completed"
      }
    },
    {
      "id": "sweep",
      "type": "liquidity_sweep",
      "params": {
        "level": "cash_rth_levels.high",
        "penetration_ticks": 1,
        "confirm_bars": 2
      }
    },
    {
      "id": "fvg",
      "type": "fair_value_gap",
      "params": {
        "direction": "bearish",
        "min_size_ticks": 8
      }
    }
  ],
  "entry": {
    "side": "short",
    "when": [
      {"id": "sweep"},
      {"id": "fvg", "after": "sweep", "within_bars": 20}
    ],
    "order": "limit",
    "price": "fvg.midpoint",
    "expire_bars": 10
  },
  "exit": {
    "stop": {"ref": "sweep.extreme", "offset_ticks": 4},
    "target": {"type": "rr", "value": 2.0},
    "time_stop": {"type": "session_end", "session": "ny_am"}
  },
  "risk": {
    "contracts": 1,
    "session": "ny_am",
    "max_trades_per_session": 2,
    "daily_loss_stop_usd": 500.0
  },
  "costs": {
    "commission_per_side_usd": 2.5,
    "market_slippage_ticks": 1,
    "news_open_slippage_ticks": 3,
    "limit_through_ticks": 1
  },
  "reference_instruments": [],
  "agents": [],
  "consensus_rule": {"type": "all"},
  "meta": {
    "source": "english",
    "source_prompt": "Sell NQ after the prior cash high is swept and a bearish fair value gap prints.",
    "parent_version": null
  }
}
